+"""Command-boundary regressions; no package installer or CocoaPods is executed."""
+import importlib.util
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest import mock
+
+spec=importlib.util.spec_from_file_location('candidate_native',Path(__file__).resolve().parents[1]/'native/hosted_native.py')
+native=importlib.util.module_from_spec(spec);spec.loader.exec_module(native)
+
+class StopFixture(Exception): pass
+
+class FrozenRubyBundleTests(unittest.TestCase):
+    def exercise(self, fail_bundle):
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp);(root/'package.json').write_text('{}')
+            calls=[]
+            def command(args,*unused,**kwargs):
+                calls.append(args)
+                if args==['env','BUNDLE_FROZEN=true','bundle','install'] and fail_bundle:
+                    raise StopFixture('frozen lock rejected')
+                if 'pod' in args:raise StopFixture('comparison command reached')
+            with mock.patch.multiple(native,ROOT=root,EVIDENCE=root/'metadata.json',PRIVATE=root/'private',PLATFORM='IOS'), \
+                 mock.patch.object(native,'command',side_effect=command), \
+                 mock.patch.object(native,'fixtures'),mock.patch.object(native,'install_maestro'), \
+                 mock.patch.object(native.subprocess,'check_output',return_value=b''), \
+                 mock.patch.dict(os.environ,{'KEEPER_POD_LOCK_REPAIR':'0'}):
+                native.save({'commands':[]})
+                with self.assertRaises(StopFixture):native.prepare()
+            return calls
+    def test_deployment_uses_frozen_bundle_not_global_pod(self):
+        calls=self.exercise(False)
+        bundle=['env','BUNDLE_FROZEN=true','bundle','install']
+        pod=['env','BUNDLE_FROZEN=true','bundle','exec','pod','install','--deployment']
+        self.assertIn(bundle,calls);self.assertEqual(calls[-1],pod)
+        self.assertLess(calls.index(bundle),calls.index(pod))
+        self.assertFalse(any(c[0] in ('gem','pod','sudo') for c in calls))
+    def test_frozen_bundle_failure_prevents_pod_comparison(self):
+        calls=self.exercise(True)
+        self.assertEqual(calls[-1],['env','BUNDLE_FROZEN=true','bundle','install'])
+        self.assertFalse(any('pod' in c for c in calls))
+
+if __name__=='__main__':unittest.main()
